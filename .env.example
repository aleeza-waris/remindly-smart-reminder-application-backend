PORT=5000
NODE_ENV=development
# Development: allow the local Next.js frontend. In production, set NODE_ENV=production
# and CLIENT_ORIGINS to the exact deployed HTTPS frontend origin(s), comma-separated.
CLIENT_ORIGINS=http://localhost:3000
# Production example only (replace with the real deployed origin):
# CLIENT_ORIGINS=https://your-app.example.com
MONGODB_URI=mongodb://127.0.0.1:27017/remindly
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/remindly_phase2_test
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_api_refresh_token
GMAIL_SENDER_EMAIL=your_sender_email@example.com
